{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/preview.py": {
      "maxDuration": 60,
      "excludeFiles": "{roomquest/catalogs/**,cities/**,docs/**,reports/**,supabase/**,xmlui/**,tests/**,website/**,node_modules/**,**/*.webm,**/*.png,**/*.jpg,**/*.jpeg}"
    },
    "api/preview_1.py": {
      "maxDuration": 60,
      "excludeFiles": "{roomquest/catalogs/**,cities/**,docs/**,reports/**,supabase/**,xmlui/**,tests/**,website/**,node_modules/**,**/*.webm,**/*.png,**/*.jpg,**/*.jpeg}"
    },
    "api/preview_2.py": {
      "maxDuration": 60,
      "excludeFiles": "{roomquest/catalogs/**,cities/**,docs/**,reports/**,supabase/**,xmlui/**,tests/**,website/**,node_modules/**,**/*.webm,**/*.png,**/*.jpg,**/*.jpeg}"
    },
    "api/preview_3.py": {
      "maxDuration": 60,
      "excludeFiles": "{roomquest/catalogs/**,cities/**,docs/**,reports/**,supabase/**,xmlui/**,tests/**,website/**,node_modules/**,**/*.webm,**/*.png,**/*.jpg,**/*.jpeg}"
    },
    "api/preview_4.py": {
      "maxDuration": 60,
      "excludeFiles": "{roomquest/catalogs/**,cities/**,docs/**,reports/**,supabase/**,xmlui/**,tests/**,website/**,node_modules/**,**/*.webm,**/*.png,**/*.jpg,**/*.jpeg}"
    },
    "api/preview_5.py": {
      "maxDuration": 60,
      "excludeFiles": "{roomquest/catalogs/**,cities/**,docs/**,reports/**,supabase/**,xmlui/**,tests/**,website/**,node_modules/**,**/*.webm,**/*.png,**/*.jpg,**/*.jpeg}"
    },
    "api/geocode.py": {
      "maxDuration": 60,
      "excludeFiles": "{roomquest/catalogs/**,cities/**,docs/**,reports/**,supabase/**,xmlui/**,tests/**,website/**,node_modules/**,**/*.webm,**/*.png,**/*.jpg,**/*.jpeg}"
    },
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{roomquest/catalogs/**,cities/**,docs/**,reports/**,supabase/**,xmlui/**,tests/**,website/**,node_modules/**,**/*.webm,**/*.png,**/*.jpg,**/*.jpeg}"
    }
  },
  "routes": [
    {
      "src": "/api/provider-pilot/orangeburg",
      "dest": "/api/index.py"
    },
    {
      "src": "/api/provider-pilot",
      "dest": "/api/index.py"
    },
    {
      "src": "/api/chambermaster",
      "dest": "/api/index.py"
    },
    {
      "src": "/api/geocode",
      "dest": "/api/geocode.py"
    },
    {
      "src": "/api/preview-5",
      "dest": "/api/preview_5.py"
    },
    {
      "src": "/api/preview-4",
      "dest": "/api/preview_4.py"
    },
    {
      "src": "/api/preview-3",
      "dest": "/api/preview_3.py"
    },
    {
      "src": "/api/preview-2",
      "dest": "/api/preview_2.py"
    },
    {
      "src": "/api/preview-1",
      "dest": "/api/preview_1.py"
    },
    {
      "src": "/api/preview",
      "dest": "/api/preview.py"
    },
    {
      "src": "/.*",
      "status": 404
    }
  ],
  "crons": [
    {
      "path": "/api/geocode",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/chambermaster",
      "schedule": "57 * * * *"
    }
  ],
  "ignoreCommand": "if [ \"$VERCEL_ENV\" = \"production\" ]; then exit 1; else exit 0; fi"
}
